#!/bin/bash
#----------------------------------------------------------------------------
# run_cov -- the standard coverage sweep: base + random delays, consolidated.
#
#   ./run_cov              run both sweeps (default -j 10)
#   ./run_cov -j 8         same, with 8 parallel workers
#   ./run_cov -n           print the commands without running them
#
# Three sweeps over three PURPOSE-BUILT RTL configurations
# (COVERAGE_CONFIGS in bin/rtl_sweep_configs.py). None of them is the shipping
# default: the default is just one point in the space, and these three were
# chosen to span every place the RTL has mutually exclusive implementations.
#
#   1) cov_max     MUL=1 DIV=3 (the shipping pair), counts at MAXIMUM
#                  (8 triggers, 8 HPM counters) so the most instances elaborate.
#   2) cov_stress  MUL=2 DIV=2, mid counts, WITH random ROM/SRAM wait states and
#                  ALU stalls. The multi-cycle multiplier and radix-4 divider
#                  hold state across stalls, and the wait-state edge case noted
#                  in CLAUDE.md is specific to SINGLE_CYCLE_BRANCH=1 -- which is
#                  why this pass, not cov_alt, keeps SCB=1.
#   3) cov_alt     MUL=3 DIV=1, counts ABSENT (0 triggers, 0 counters) so the
#                  tie-off arms for unimplemented slots elaborate, plus SCB=0
#                  and sync reset. At SCB=0 the select at arv_fetch.v:411 is
#                  live and both arms are reachable; at SCB=1 it is constant and
#                  the second arm is structurally unreachable.
#
# Between them: all three MUL_TYPEs, all three DIV_TYPEs, both branch-latency
# and both reset variants, and counts max/mid/absent. All three keep every
# feature enabled (SU/DEBUG/NMI/CCSR/ZICNTR, C=4 B=4 M=2) so the whole test
# suite runs in each. Configs that REMOVE logic (SU_MODE_EN=0, M_EXTENSION=0/1,
# C_EXTENSION=0, RV32E_EN=1) are left to -rtl_sweep: they gate 12 tests but buy
# little coverage, because absent features cannot cover code that is not built.
#
# Sweeps 2 and 3 APPEND (-cov+), so run/cov/ ends up the union of all three.
# Each stage is snapshotted under run/cov/runs/ so a single pass can be read on
# its own, and any PREVIOUS results are copied to run/cov_archive/<timestamp>/
# before anything is overwritten (disable with --no-archive).
#
# Cost: ~3 h per sweep at -j 10 (Verilator + toggle instrumentation dominates,
# not simulation). Budget a night for all three.
#
# OPTIONS
#   -j N                 parallel workers (default 10)
#   -n, --dry-run        print the three commands and exit, run nothing
#                        Interactively you are also offered this: answer 'none'
#                        at the archive prompt to discard instead of keeping.
#   --no-archive         do NOT keep the existing results -- they are simply
#                        overwritten and lost. Use when the previous database is
#                        known-stale (e.g. after an RTL change) and you do not
#                        want another ~30 MB copy under run/cov_archive/.
#   --archive-name NAME  label the archive instead of being prompted. Without it,
#                        an interactive run asks for a label and a detached run
#                        (no TTY) falls back to the timestamp.
#   -h, --help           this text
#----------------------------------------------------------------------------
set -u

JOBS=10
DRY=0
ARCHIVE=1
ARCHIVED=""
ARCHIVE_NAME=""
while [ $# -gt 0 ]; do
    case "$1" in
        -j)        JOBS="$2"; shift 2 ;;
        -n|--dry-run) DRY=1; shift ;;
        --no-archive) ARCHIVE=0; shift ;;
        --archive-name) ARCHIVE_NAME="$2"; shift 2 ;;
        # Print the whole leading comment block: a fixed line range silently
        # truncates the help whenever the header grows.
        -h|--help) sed -n '2,/^#---/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)         echo "usage: run_cov [-j N] [-n] [--no-archive] [--archive-name NAME]"; exit 1 ;;
    esac
done

RUN_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$RUN_DIR" || exit 1

# Fold the per-run .dat files only ONCE, at the end of each sweep. The periodic
# background merge deletes its inputs after merging, and a sweep costs ~5 GB against
# a disk with hundreds free -- so there is nothing to buy by running it unattended.
# Override with COV_MERGE_AT=<n> if disk ever becomes the constraint.
export COV_MERGE_AT=${COV_MERGE_AT:-999999}

P1=(./run_all -fast -cov  -rtl_config cov_max    -j "$JOBS")
P2=(./run_all -fast -rwsrom -rwsram -rsalu -cov+ -rtl_config cov_stress -j "$JOBS")
P3=(./run_all -fast -cov+ -rtl_config cov_alt    -j "$JOBS")

echo "  1) ${P1[*]}"
echo "  2) ${P2[*]}"
echo "  3) ${P3[*]}"
if [ $DRY -eq 1 ]; then
    echo "  (dry run -- nothing executed)"
    exit 0
fi

if ! command -v verilator >/dev/null 2>&1; then
    echo "ERROR: coverage needs Verilator (>= 5.0, for --binary --timing)"
    exit 1
fi

# Preserve anything already in cov/ before pass 1 wipes it. cp (not mv) so an
# interrupted archive still leaves the originals in place.
if [ $ARCHIVE -eq 1 ] && [ -d cov/dats ]; then
    TS="$(date +%Y%m%d-%H%M%S)"
    # Ask ONLY when there is a human at the terminal: this script is normally
    # started detached for the night, and a prompt would hang there. Discarding
    # is offered here too, so --no-archive does not have to be decided upfront.
    if [ -z "$ARCHIVE_NAME" ] && [ -t 0 ]; then
        SZ="$(du -sh cov/dats 2>/dev/null | cut -f1)"
        echo "  Existing coverage results (${SZ:-size unknown}) will be overwritten by this run."
        printf "  Label to archive them, or 'none' to DISCARD [%s]: " "$TS"
        read -r ARCHIVE_NAME || ARCHIVE_NAME=""
    fi
    case "$ARCHIVE_NAME" in
        none|None|NONE|discard|DISCARD) ARCHIVE=0 ;;
    esac
fi

if [ $ARCHIVE -eq 1 ] && [ -d cov/dats ]; then
    # Keep the timestamp as the prefix so archives still sort chronologically,
    # and reduce the label to path-safe characters.
    SAFE_NAME="$(printf '%s' "$ARCHIVE_NAME" | tr -cs 'A-Za-z0-9._-' '_' | sed 's/_*$//')"
    if [ -n "$SAFE_NAME" ]; then DEST="cov_archive/${TS}_${SAFE_NAME}"; else DEST="cov_archive/$TS"; fi
    mkdir -p "$DEST"
    cp -R cov/dats          "$DEST/" 2>/dev/null
    cp    cov/coverage.html "$DEST/" 2>/dev/null
    [ -d cov/runs ] && cp -R cov/runs "$DEST/" 2>/dev/null
    echo "  previous results archived -> $DEST"
    ARCHIVED="$DEST"
elif [ -d cov/dats ]; then
    echo "  previous results NOT archived -- they will be overwritten and lost"
fi

echo
echo "==================== SWEEP 1/3: cov_max (counts max) ===================="
"${P1[@]}" || { echo "ERROR: cov_max sweep failed"; exit 1; }
# Snapshot the pass-1-only view before pass 2 merges into it.
rm -rf cov/runs/p1_cov_max && mkdir -p cov/runs/p1_cov_max
cp -R cov/dats cov/runs/p1_cov_max/ 2>/dev/null
cp cov/coverage.html cov/runs/p1_cov_max/ 2>/dev/null
echo "  snapshot: cov/runs/p1_cov_max"

echo
echo "======== SWEEP 2/3: cov_stress + random alu/rom/sram wait states ========"
"${P2[@]}" || { echo "ERROR: cov_stress sweep failed"; exit 1; }
rm -rf cov/runs/p2_plus_stress && mkdir -p cov/runs/p2_plus_stress
cp -R cov/dats cov/runs/p2_plus_stress/ 2>/dev/null
cp cov/coverage.html cov/runs/p2_plus_stress/ 2>/dev/null
echo "  snapshot: cov/runs/p2_plus_stress  (union of passes 1+2)"

echo
echo "=============== SWEEP 3/3: cov_alt (counts absent, SCB=0) ==============="
"${P3[@]}" || { echo "ERROR: cov_alt sweep failed"; exit 1; }

echo
echo "======================================================================"
echo "  consolidated (all 3 passes)  : cov/coverage.html"
echo "  cov_max only                 : cov/runs/p1_cov_max/coverage.html"
echo "  cov_max + cov_stress         : cov/runs/p2_plus_stress/coverage.html"
[ -n "${ARCHIVED:-}" ] && \
echo "  previous run archived at     : $ARCHIVED"
echo "  browse                       : ./view_cov"
echo "======================================================================"
